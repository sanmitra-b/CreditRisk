# File paths
DATA_DIR=./data
MODEL_DIR=./models
ARTIFACT_DIR=./artifacts
LOG_LEVEL=INFO
RANDOM_SEED=42

# Database configuration (Docker Compose network uses host 'db', local uses 'localhost')
DATABASE_URL=postgresql+psycopg://credit_app:credit_app_dev@localhost:5432/credit_risk
ANALYTICS_DATABASE_URL=postgresql+psycopg://analytics_user:analytics_dev@localhost:5432/credit_risk
POSTGRES_DB=credit_risk
POSTGRES_USER=credit_app
POSTGRES_PASSWORD=credit_app_dev
ANALYTICS_PASSWORD=analytics_dev
SQL_TIMEOUT_MS=8000
MAX_SQL_ROWS=200

# LLM & Search Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite
GEMINI_COMPLEX_MODEL=gemini-3.8-flash
WEB_SEARCH_PROVIDER=ddgs
MAX_WEB_RESULTS=5
